{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "Mode": "",
    "Endpoint": "",
    "ChatModel": "gpt-5-mini",
    "EmbeddingModel": "text-embedding-3-small"
  },
  "VectorStore": {
    "Provider": "InMemory"
  },
  "Rag": {
    "IngestOnStartup": true,
    "ChunkSize": 800,
    "ChunkOverlap": 120,
    "Candidates": 16,
    "TopK": 4,
    "MinScore": 0.12
  },
  "Telemetry": {
    "Console": false
  }
}
